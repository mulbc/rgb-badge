firmware/build/
firmware/sdkconfig
firmware/sdkconfig.old
CMakeFiles/
CMakeCache.txt

# Python/CadQuery tooling
__pycache__/
*.py[cod]
.venv/
mechanical/build/

# Editor and operating-system state
.idea/
.vscode/
.DS_Store
Thumbs.db
