(text "TLC59581 - column sinks and local support" (at 20.32 20.32 0) (effects (font (size 2 2)) (justify left)) (uuid "255e5690-fdf0-530d-8c7a-9e483b3de5d3"))
(text "48 outputs map directly to matching colour/column labels on the matrix sheets." (at 20.32 30.48 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "e2d75a22-c16b-5048-bf2f-f823fb0d85b1"))
(text "Current reference - place at pins 1 / 56" (at 223.52 48.26 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "914f571e-1197-5399-a56e-fc8ac57e61be"))
(text "Route R1 return to IREFGND, then quiet GND return." (at 223.52 76.2 0) (effects (font (size 1.016 1.016)) (justify left)) (uuid "152c8de5-6b23-5f4b-8d02-52ca578acf6b"))
(text "Place C1 directly at VCC / ground plane." (at 223.52 106.68 0) (effects (font (size 1.016 1.016)) (justify left)) (uuid "62e8271a-6500-559d-8f9c-fe3aef6cb177"))
(text "DRAFT supply boundary assumptions" (at 223.52 129.54 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "381adf53-1a78-5dd1-8287-c53fd5e78cbd"))
(text "Flags only declare future supply/return for ERC." (at 223.52 137.16 0) (effects (font (size 1.016 1.016)) (justify left)) (uuid "4dffb1f9-309d-58a3-9d52-dd8f56ca8755"))
(text "Replace when the real power source is captured." (at 223.52 142.24 0) (effects (font (size 1.016 1.016)) (justify left)) (uuid "9ef3f247-74ed-5e5d-80cd-3396bea73799"))
(text "No power source is implemented on this sheet." (at 223.52 177.8 0) (effects (font (size 1.016 1.016)) (justify left)) (uuid "83142b55-550c-578f-8946-0acd0012fccb"))
(text "IREF calculation: 1.209 V x 157.4 / 39.2 kohm = 4.85 mA nominal at BC=7, CC=511." (at 20.32 203.2 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "ee37f8fa-9b48-518c-af17-107176d33033"))
(text "This is a nominal calculation, not a guaranteed current limit. See driver-capture.md." (at 20.32 210.82 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "fd4fe640-08a2-56ff-b868-108878bc3d13"))
(text "U1 pin 57 is the exposed power-ground pad: solder to GND and provide thermal vias in layout." (at 20.32 221 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "463a0e0e-c863-52f7-992a-267d74ba072a"))
(text "Footprint uses TI RTQ0056E. Confirm E versus G package from supplied lot before layout release." (at 20.32 228.6 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "40023e6a-def6-50e1-a5e5-7b8db7f519ce"))
(text "No /OE pin exists. Row inhibit and VLED disable must provide boot/reset/programming darkness." (at 20.32 239 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "1d2667fe-cedc-5c64-aedf-ee87b4b1bf40"))
(text "LED_SIN/SCLK/LAT/GCLK/SOUT are future controller interfaces; GPIO assignment is still open." (at 20.32 246.62 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "7eb42e28-e69e-5b2a-9deb-90262bf29d80"))
